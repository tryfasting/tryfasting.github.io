---
import BlogLayout from '../../blog/BlogLayout.astro';
import PostList from '../../blog/PostList.astro';
import { getPublishedPosts } from '../../blog/posts';

const posts = await getPublishedPosts();
---
<BlogLayout title="유선종 블로그" description="개발하며 배운 내용을 기록합니다.">
  <section class="page-intro">
    <h1>글 목록</h1>
    <p>개발하며 배운 내용을 기록합니다.</p>
  </section>
  <PostList posts={posts} />
</BlogLayout>
